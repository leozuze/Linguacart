{
  "manifest_version": 3,
  "name": "LinguaCart",
  "version": "0.0.1",
  "description": "Shop in Shona",
  "background": {
    "service_worker": "background/service-worker.js"
  },
"content_scripts": [
  {
    "matches": ["https://www.amazon.com/*"],
    "exclude_matches": [
      "https://www.amazon.com/ap/*",
      "https://www.amazon.com/gp/cart/*",
      "https://www.amazon.com/cart/*",
      "https://www.amazon.com/gp/buy/*",
      "https://www.amazon.com/gp/css/*",
      "https://www.amazon.com/gp/your-account/*",
      "https://www.amazon.com/a/*"
    ],
    "js": ["content/content-script.js"],
    "all_frames": false,
    "run_at": "document_idle"
  }
]
}