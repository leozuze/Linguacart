{
  "manifest_version": 3,
  "name": "LinguaCart",
  "version": "0.0.1",
  "description": "Shop in Shona",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.com/*"],
      "js": ["content/content-script.js"]
    }
  ]
}