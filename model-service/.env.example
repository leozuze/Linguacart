TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
EMBEDDING_MODEL=intfloat/multilingual-e5-base
MODEL_SERVICE_PORT=8001
DEVICE=cpu

# Optional limits (defaults shown)
MAX_INPUT_TOKENS=256
MAX_NEW_TOKENS=256
NUM_BEAMS=4
BATCH_SIZE=16
MAX_ITEMS_PER_REQUEST=64
NO_REPEAT_NGRAM_SIZE=4
TORCH_THREADS=0

# Fake models for teammates (instant startup, no downloads). Never for evaluation.
STUB_MODELS=false

# Set only when sharing the service over a network; clients send it as header X-API-Key
API_KEY=
